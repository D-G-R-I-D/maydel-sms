# Server-side only: where the BFF reaches the API.
API_BASE_URL=http://localhost:5178
# Optional: Google Identity Services client id. Empty hides the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional: extra browser origins allowed to call the BFF when a tunnel/proxy hides the public host.
# Comma-separated; "*." matches any subdomain. Dev default: VS Code dev tunnels, *.trycloudflare.com, *.ngrok-free.app. Production: none.
# TRUSTED_ORIGINS=https://*.devtunnels.ms
# Optional: force the Secure cookie flag (defaults to on when NODE_ENV=production).
# COOKIE_SECURE=false
# Optional: the address phones open when they scan the staff clock-in QR (e.g. your dev tunnel or the live site).
# Unset: the kiosk uses the address it was opened on, so open it through the tunnel, not localhost.
# PUBLIC_SITE_URL=https://abc-3000.uks1.devtunnels.ms
