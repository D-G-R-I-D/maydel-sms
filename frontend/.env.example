# Server-side only: where the BFF reaches the API.
API_BASE_URL=http://localhost:5178
# Optional: Google Identity Services client id. Empty hides the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional: extra browser origins allowed to call the BFF when a tunnel/proxy hides the public host.
# Comma-separated; "*." matches any subdomain. Defaults to https://*.devtunnels.ms in dev, none in production.
# TRUSTED_ORIGINS=https://*.devtunnels.ms
# Optional: force the Secure cookie flag (defaults to on when NODE_ENV=production).
# COOKIE_SECURE=false
