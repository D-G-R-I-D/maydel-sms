# Local development only. Copy to .env (git-ignored). Never reuse these values anywhere real.
POSTGRES_PASSWORD=maydel_dev_only
# Host port for Postgres. Use e.g. 5434 if a Postgres installed on your machine already listens on 5432.
POSTGRES_PORT=5432
JWT_SIGNING_KEY=dev-only-signing-key-replace-me-0123456789abcdef
SEED_ADMIN_EMAIL=admin@maydel.test
SEED_ADMIN_PASSWORD=Demo#Pass2026
# OAuth web client id from Google Cloud console. Leave empty to disable "Continue with Google".
GOOGLE_CLIENT_ID=
# Photo storage. Local disk by default. Production: a private S3-compatible bucket (Cloudflare R2, see ADR-006):
# STORAGE__PROVIDER=S3
# STORAGE__S3__SERVICEURL=https://<account-id>.r2.cloudflarestorage.com
# STORAGE__S3__BUCKET=maydel-media
# STORAGE__S3__ACCESSKEYID=
# STORAGE__S3__SECRETACCESSKEY=
