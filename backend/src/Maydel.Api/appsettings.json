{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "maydel-api",
    "Audience": "maydel-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "DemoData": false
  },
  "Storage": {
    "RootPath": "uploads"
  },
  "School": {
    "Name": "Maydel Spring Schools, Abuja",
    "Motto": "The Well Spring of Knowledge",
    "Address": "Plot D57 Cajaah Estate, Orozo, Abuja",
    "Phone": "09133595634",
    "Email": "admin@maydelspringschools.com",
    "Website": "www.maydelspringschools.com",
    "PrincipalName": null
  }
}
