<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Maydel.Domain\Maydel.Domain.csproj" />
    <ProjectReference Include="..\Maydel.Application\Maydel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The email layout (MailMessages) is checked directly. -->
    <InternalsVisibleTo Include="Maydel.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Anthropic" Version="12.58.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.6" />
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- School crest for report cards (from the brand assets in ../website). Replaced by the school profile upload in E2.6. -->
    <EmbeddedResource Include="Reports\Assets\maydellogo.png" LogicalName="Maydel.ReportLogo.png" />
    <!-- Starter website pictures (resized to 1600 px), seeded once into storage. -->
    <EmbeddedResource Include="Seed\Site\*.jpg" LogicalName="Maydel.Seed.Site.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
