# API image. Build from the repo root: docker build -f backend/Dockerfile backend
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# global.json is left out: the image pins its own SDK.
COPY Directory.Build.props Maydel.slnx ./
COPY src/Maydel.Domain/Maydel.Domain.csproj src/Maydel.Domain/
COPY src/Maydel.Application/Maydel.Application.csproj src/Maydel.Application/
COPY src/Maydel.Infrastructure/Maydel.Infrastructure.csproj src/Maydel.Infrastructure/
COPY src/Maydel.Api/Maydel.Api.csproj src/Maydel.Api/
RUN dotnet restore src/Maydel.Api/Maydel.Api.csproj
COPY src/ src/
# The OpenAPI contract is generated by local/CI builds and committed; skip it here.
RUN dotnet publish src/Maydel.Api/Maydel.Api.csproj -c Release -o /app --no-restore -p:OpenApiGenerateDocuments=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
# Uploads live on a volume; create it owned by the non-root user so the volume inherits the ownership.
RUN mkdir -p /data/uploads && chown "$APP_UID" /data/uploads
COPY --from=build /app .
USER $APP_UID
ENV ASPNETCORE_HTTP_PORTS=8080 \
    Storage__RootPath=/data/uploads
EXPOSE 8080
ENTRYPOINT ["dotnet", "Maydel.Api.dll"]
